# --- Dependências ---
# Nunca enviar a pasta node_modules (muito pesada e gerada pelo npm install)
node_modules/
jspm_packages/

# --- Build / Saída do TypeScript ---
# Ignora a pasta onde o código compilado (JS) é gerado
dist/
build/
out/
*.tsbuildinfo

# --- Variáveis de Ambiente (SEGURANÇA) ---
# Jamais envie senhas, chaves de API ou tokens para o GitHub
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# --- Editor: VS Code ---
# Configurações específicas do seu editor que não devem afetar os outros 4 alunos
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
.history/
*.code-workspace

# --- Logs e Debug ---
# Registros de erros e logs de execução
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/
*.log
.pnpm-debug.log*

# --- Sistema Operacional ---
# Arquivos inúteis gerados pelo Windows ou macOS
.DS_Store
Thumbs.db
desktop.ini

# --- Bancos de Dados / Drizzle ---
# Se usarem banco de dados local ou arquivos de dump
*.sql
*.sqlite
